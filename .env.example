# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: used by /api/cron/dispatch-alerts to drain the alert queue.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Geocoding for the "Where" box (server-side proxy at /api/geocode) ---
# Uses Photon (OpenStreetMap, no key) by default. Set a Mapbox token to use Mapbox instead.
MAPBOX_ACCESS_TOKEN=

# --- Saved-search alerts ---
# Shared secret for the cron endpoint (send as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=change-me
# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com
# Email via Resend (https://resend.com); leave empty to skip email alerts.
RESEND_API_KEY=
ALERTS_FROM_EMAIL=ShareYourPot <alerts@example.com>
# Public base URL used in alert links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
